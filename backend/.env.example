# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | testing | production
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Signs auth tokens. Required in production (same generator as SECRET_KEY).
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Only these email domains may register.
ALLOWED_EMAIL_DOMAINS=jacks.sdstate.edu

# Email: console (prints to server log, dev default) | smtp (production default)
MAIL_BACKEND=console
MAIL_FROM=ReportSDState <no-reply@reportsdstate.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Rate-limit storage. memory:// is fine for a single worker; use redis:// for several.
RATELIMIT_STORAGE_URI=memory://

# Comma-separated list of origins allowed to call the API (Expo dev server, web build, ...)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# SQLAlchemy URL. Relative sqlite paths live in backend/instance/.
DATABASE_URL=sqlite:///reportsdstate.db

# Field-level encryption for reporter IDs on reports. Required in production.
#   DATA_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   DATA_HMAC_KEY:       python -c "import secrets; print(secrets.token_urlsafe(48))"
# Losing DATA_ENCRYPTION_KEY makes existing reporter IDs unrecoverable - back it up.
DATA_ENCRYPTION_KEY=
DATA_HMAC_KEY=

# Password for the synthetic accounts created by `flask --app wsgi seed-db` (test data only).
SEED_DEMO_PASSWORD=Jackrabbit-Demo-2026

# Emergency workflow. Keep DEMO_MODE=true for grading and demos: every call button then
# dials DEMO_CALL_NUMBER (set this to a phone the team controls) instead of UPD/911/988.
DEMO_MODE=true
DEMO_CALL_NUMBER=+16055550100
CAMPUS_POLICE_NUMBER=+16056885117
CRISIS_LINE_NUMBER=988
