# Copy this file to backend/.env and fill in real values. Never commit .env.

# development | testing | production
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of origins allowed to call the API (Expo dev server, web build, ...)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
